{
  "name": "bbx-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Task manager service for ai-assistant-android: tasks/projects/reminders for the owner and the secretary agent",
  "engines": { "node": ">=22" },
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --external:pg && esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.js --external:pg",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": { "pg": "^8.13.1" },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
